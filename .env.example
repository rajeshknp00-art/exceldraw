# Environment variables for Healthcare AI Triage Assistant

# Backend
DJANGO_DEBUG=False
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./triage.db
# For PostgreSQL: postgresql://postgres:postgres@db:5432/triage

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# FREE AI SERVICES (Replace OpenAI/ElevenLabs)
# ============================================

# Groq API Key (FREE - https://console.groq.com/keys)
# Free tier: 30 req/min, 6000 tokens/min, 30K tokens/day
# Models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# LiveKit (FREE Cloud - https://livekit.io/cloud)
# Or self-hosted LiveKit (open source)
# Free tier: 1000 monthly participant minutes
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Use LiveKit for STT/TTS (optional, can use Groq Whisper + Edge TTS instead)
USE_LIVEKIT_STT=false
USE_LIVEKIT_TTS=false

# Groq Whisper STT (already included in GROQ_API_KEY)
# Groq Whisper (free tier): 100 req/min, 25MB max file
STT_SERVICE=groq  # groq, google, aws, azure

# Edge TTS (Microsoft - completely free, no API key needed)
# Used as fallback for TTS when LiveKit not available
# No API key needed - uses Microsoft Edge TTS voices

# ============================================
# RAG / Knowledge Graph
# ============================================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root
KNOWLEDGE_GRAPH_PATH=/app/backend/knowledge-graph

# ============================================
# Multi-language
# ============================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,zh,hi

# ============================================
# Application
# ============================================
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# OPTIONAL: Legacy/OpenAI (if you want to use them)
# ============================================
# OPENAI_API_KEY=sk-...
# ELEVENLABS_API_KEY=your-elevenlabs-key
# STT_SERVICE=openai