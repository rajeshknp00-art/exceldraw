# Environment variables for Healthcare AI Triage Assistant

# Backend
DJANGO_DEBUG=False
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# Database
POSTGRES_DB=triage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key
STT_SERVICE=openai  # or google, aws, azure

# RAG / Knowledge Graph
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root
KNOWLEDGE_GRAPH_PATH=/app/backend/knowledge-graph

# Multi-language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,zh,hi

# Application
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000